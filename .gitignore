node_modules/
.env
build/
.DS_Store

# Python bytecode from scripts/blender/. Regenerated on import, never an input.
# No mid-pattern slash, so it matches at any depth — the trap the block below records.
__pycache__/
*.pyc
.claude/settings.local.json

# Scratch scripts and quarantined cloud-sync conflict copies.
# Deliberately absent: any pattern matching " 2"/" 3"-style conflict-copy names —
# those must stay visible in `git status` so a lost edit cannot silently vanish.
.tmp-*.mjs
scripts/.tmp-*.mjs
_conflict-review/
