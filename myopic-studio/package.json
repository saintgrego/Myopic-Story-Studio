{
  "name": "myopic-studio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@types/node": "^16.18.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "three": "^0.160.0",
    "typescript": "^4.9.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.160.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.3",
    "postcss": "^8.4.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.0"
  },
  "proxy": "http://localhost:4000",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "eject": "react-scripts eject",
    "server": "node server/index.js",
    "build:poses": "BLENDER=${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}; \"$BLENDER\" --background --factory-startup --python scripts/blender/build-pose-glbs.py -- assets-src/human-base-meshes-bundle-v1.4.1/human_base_meshes_bundle.blend public/assets/poses",
    "dev": "concurrently -n server,web -c blue,green \"npm:server\" \"npm:start\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!three[/\\\\]examples[/\\\\]jsm[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^three$": "<rootDir>/node_modules/three/build/three.cjs"
    }
  }
}
